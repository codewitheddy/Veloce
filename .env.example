# ==========================================
# Ropenix Collections - Environment Configuration
# ==========================================

# Application URLs
APP_URL="http://localhost:3000"
FRONTEND_URL="https://ropenix.co.ke"
ADMIN_URL="https://ropenix.co.ke/admin"
PORT=3000
NODE_ENV="production"
RESET_TOKEN_EXPIRY_MINUTES=60

# ==========================================
# Email SMTP Configuration
# ==========================================
EMAIL_ENABLED=true
EMAIL_DEV_MODE=false # Set to true to redirect non-admin customer emails in test environments
EMAIL_HOST="smtppro.zoho.com"
SMTP_HOST="smtppro.zoho.com"
EMAIL_PORT=465
SMTP_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER="admin@ropenix.co.ke"
SMTP_USER="admin@ropenix.co.ke"
EMAIL_HOST_PASSWORD="YOUR_ZOHO_MAIL_APP_PASSWORD"
SMTP_PASS="YOUR_ZOHO_MAIL_APP_PASSWORD"
DEFAULT_FROM_EMAIL="Ropenix Collections <admin@ropenix.co.ke>"
EMAIL_FROM="Ropenix Collections <admin@ropenix.co.ke>"
REPLY_TO_EMAIL="ropenixkenya@gmail.com"
ADMIN_EMAIL="ropenixkenya@gmail.com"

# ==========================================
# Safaricom M-Pesa Paybill Configuration
# ==========================================
PAYBILL_NUMBER="303030"
PAYBILL_ACCOUNT_NUMBER="2047728455"
PAYBILL_ACCOUNT_NAME="ROPENIX INVESTMENTS LTD"

# ==========================================
# Admin Operational Digest & Alert Settings
# ==========================================
ADMIN_DIGEST_ENABLED=true
ADMIN_DIGEST_TIMES="08:00,17:00"
ADMIN_DIGEST_RECIPIENTS="admin@ropenix.co.ke,ropenixkenya@gmail.com"
ADMIN_DIGEST_SEND_WHEN_EMPTY=false
PENDING_VERIFICATION_ALERT_HOURS=4
PAYMENT_REMINDER_HOURS=24
MAX_PAYMENT_REMINDERS=2
AUTO_CANCEL_ENABLED=false
AUTO_CANCEL_HOURS=48
REVIEW_REQUEST_DAYS=7

# ==========================================
# Production Database Configuration (Optional PostgreSQL)
# Defaults to robust SQLite database (veloce.sqlite) when unset
# ==========================================
# DATABASE_URL="postgres://postgres:password@localhost:5432/ropenix_db"
# POSTGRES_DB="ropenix_db"
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="password"
# POSTGRES_HOST="localhost"
# POSTGRES_PORT=5432
# POSTGRES_SSL=false

# ==========================================
# Cloudinary Media Hosting & Edge CDN Configuration
# ==========================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="ropenix_products"
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET="ropenix_products"
