# Celery & Redis Distributed Task Queue Configuration
# Development: redis://localhost:6379/0
# Production / Staging: redis://:strong_password@redis-server:6379/0 or rediss:// for SSL
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
CELERY_TIMEZONE="UTC"
CELERY_TASK_ALWAYS_EAGER="False" # Set to True for local testing without running Redis

# Cloudinary Cloud Media & CDN Storage Configuration
