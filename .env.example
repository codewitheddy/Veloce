# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Django Backend API Configuration
# Base URL for external Django REST Framework API (e.g. http://127.0.0.1:8000/api or https://api.veloce.io)
VITE_API_BASE_URL="http://127.0.0.1:8000/api"

# Production Database Configuration (PostgreSQL 15+ / Supabase / AWS RDS / Neon)
# Set standard DATABASE_URL or individual POSTGRES_* parameters
DATABASE_URL="postgres://postgres:secure_password@localhost:5432/veloce_db"
POSTGRES_DB="veloce_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="secure_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_SSL=false

# Safaricom M-Pesa Daraja API Integration (Live STK Push & Callbacks)
# Set Consumer Key & Secret from Safaricom Developer Portal
MPESA_ENVIRONMENT="sandbox" # Change to "production" for live Safaricom Daraja API
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
