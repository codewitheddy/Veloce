# ==============================================================================
# Ropenix Collections - cPanel Production Environment Variables (.env)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in your cPanel application root folder
#    (e.g., /home/YOUR_CPANEL_USER/ropenix-app/.env)
# 2. Update the values below to match your live cPanel domain, MySQL database,
#    Zoho/cPanel SMTP credentials, Cloudinary keys, and M-PESA details.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application URLs
# ------------------------------------------------------------------------------
NODE_ENV=production

# In cPanel Node.js Selector, Phusion Passenger passes PORT automatically.
# Set default port for standalone/local testing:
PORT=3000

# Base URL of your production store (without trailing slash)
APP_URL="https://ropenix.co.ke"
FRONTEND_URL="https://ropenix.co.ke"
ADMIN_URL="https://ropenix.co.ke/admin"

# Password reset token lifetime (in minutes)
RESET_TOKEN_EXPIRY_MINUTES=60

# JWT Authentication Secret Key (Generate a random 64-character string)
JWT_SECRET="generate-a-secure-random-64-character-jwt-key-for-production"

# ------------------------------------------------------------------------------
# 2. Production MySQL Database Configuration (cPanel MySQL Databases)
# ------------------------------------------------------------------------------
# In cPanel -> "MySQL Databases":
# 1. Create a database (e.g., cpaneluser_ropenix)
# 2. Create a database user (e.g., cpaneluser_ropenix_admin)
# 3. Add user to database and grant ALL PRIVILEGES
# The application automatically creates and verifies all tables on startup.
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="cpaneluser_ropenix_admin"
DB_PASSWORD="your_strong_mysql_password_here"
DB_NAME="cpaneluser_ropenix"

# Optional fallback connection URL format:
# DATABASE_URL="mysql://cpaneluser_ropenix_admin:password@127.0.0.1:3306/cpaneluser_ropenix"

# ------------------------------------------------------------------------------
# 3. SMTP Email Gateway (Zoho Mail Pro / cPanel Webmail)
# ------------------------------------------------------------------------------
# Enable production email notifications (Order confirmations, status alerts, receipts)
EMAIL_ENABLED=true
EMAIL_DEV_MODE=false

# Zoho Mail SMTP Settings (Recommended):
EMAIL_HOST="smtppro.zoho.com"
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER="admin@ropenix.co.ke"
EMAIL_HOST_PASSWORD="your_zoho_smtp_password"

# Alternatively, for cPanel Webmail SMTP:
# EMAIL_HOST="mail.ropenix.co.ke"
# EMAIL_PORT=465
# EMAIL_USE_SSL=true
# EMAIL_HOST_USER="noreply@ropenix.co.ke"
# EMAIL_HOST_PASSWORD="your_cpanel_email_password"

DEFAULT_FROM_EMAIL="Ropenix Collections <admin@ropenix.co.ke>"
EMAIL_FROM="Ropenix Collections <admin@ropenix.co.ke>"
REPLY_TO_EMAIL="ropenixkenya@gmail.com"
ADMIN_EMAIL="ropenixkenya@gmail.com"

# ------------------------------------------------------------------------------
# 4. Safaricom Lipa na M-PESA Paybill Configuration
# ------------------------------------------------------------------------------
PAYBILL_NUMBER="303030"
PAYBILL_ACCOUNT_NUMBER="2047728455"
PAYBILL_ACCOUNT_NAME="ROPENIX INVESTMENTS LTD"

# ------------------------------------------------------------------------------
# 5. Admin Operational Digest & Automation Schedules
# ------------------------------------------------------------------------------
ADMIN_DIGEST_ENABLED=true
ADMIN_DIGEST_TIMES="08:00,17:00"
ADMIN_DIGEST_RECIPIENTS="admin@ropenix.co.ke,ropenixkenya@gmail.com"
ADMIN_DIGEST_SEND_WHEN_EMPTY=false
PENDING_VERIFICATION_ALERT_HOURS=4
PAYMENT_REMINDER_HOURS=24
MAX_PAYMENT_REMINDERS=2
AUTO_CANCEL_ENABLED=false
AUTO_CANCEL_HOURS=48
REVIEW_REQUEST_DAYS=7

# ------------------------------------------------------------------------------
# 6. Cloudinary Media Hosting & Edge CDN Configuration
# ------------------------------------------------------------------------------
# Obtain from https://cloudinary.com/console (Dashboard -> Product Environment Credentials)
CLOUDINARY_CLOUD_NAME="Ropenix"
CLOUDINARY_API_KEY="475339869159685"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"
CLOUDINARY_UPLOAD_PRESET="ropenix_products"

# Client-side exposed variables for direct image uploading
VITE_CLOUDINARY_CLOUD_NAME="Ropenix"
VITE_CLOUDINARY_UPLOAD_PRESET="ropenix_products"

# ------------------------------------------------------------------------------
# 7. Gemini AI Assistant (Optional / Product Copywriting)
# ------------------------------------------------------------------------------
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
