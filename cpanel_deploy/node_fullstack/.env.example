# ==============================================================================
# Veloce Platform - cPanel Production Environment Variables (.env)
# ==============================================================================
# Copy this file to '.env' in your cPanel application root directory.

# ------------------------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
# In cPanel Node.js Selector, PORT is injected automatically by Phusion Passenger.
# If testing manually or running standalone, specify the port:
PORT=3000

# ------------------------------------------------------------------------------
# 2. cPanel MySQL / MariaDB Database Configuration
# ------------------------------------------------------------------------------
# In cPanel, create a database via "MySQL Databases" wizard:
# e.g., Database Name: cpaneluser_veloce
# e.g., Database User: cpaneluser_admin
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_veloce
DB_USER=cpaneluser_admin
DB_PASSWORD=your_strong_mysql_password

# ------------------------------------------------------------------------------
# 3. cPanel SMTP Email Service Configuration
# ------------------------------------------------------------------------------
# In cPanel, create an email account under "Email Accounts" (e.g., noreply@yourdomain.com):
EMAIL_HOST=mail.yourdomain.com
EMAIL_PORT=465
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your_email_account_password
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL="Veloce Hub" <noreply@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com

# ------------------------------------------------------------------------------
# 4. Gemini AI Integration (Optional / Copywriting Assistant)
# ------------------------------------------------------------------------------
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. Cloudinary Media CDN Configuration (Recommended for Product Images)
# ------------------------------------------------------------------------------
# Obtain from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=veloce_products
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=veloce_products

# ------------------------------------------------------------------------------
# 6. Django REST Backend Configuration (Only if using Django Option)
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=generate_a_random_50_char_secret_key_here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
